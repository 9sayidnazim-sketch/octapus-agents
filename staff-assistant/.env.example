# Octapus Staff Assistant Environment Configuration
# ============================================================

# Security & Key Encryption (Required for saving provider keys at rest)
MASTER_KEY="your-32-byte-fernet-key-or-secure-master-passphrase"

# Authentication
# Provide plain password or bcrypt hash
STAFF_PASSWORD="choose-a-strong-staff-password"
STAFF_PASSWORD_HASH=""

# Database Storage (SQLite path or URL)
DATABASE_URL="sqlite:///staff_assistant.db"

# Optional Default AI Provider & Model Configuration
ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

DEFAULT_PROVIDER="anthropic"
DEFAULT_MODEL="claude-sonnet-5-5"

# Context & Memory Limits
CONTEXT_RECENT_MESSAGES=20
SUMMARY_THRESHOLD=20

# Octapus Internal REST API
OCTAPUS_API_BASE_URL="https://api.example.com/v1"
OCTAPUS_API_KEY=""

# Operations & Email Guardrails
DRY_RUN=true

# Notification & SMTP Configuration (Optional)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@octapus.llc"
SMTP_PASSWORD=""
SMTP_FROM="Octapus Assistant <notifications@octapus.llc>"
